<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luyện Tập Trắc Nghiệm - Cổng Ôn Tập K71</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --success: #16a34a;
            --danger: #dc2626;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
        }
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: var(--bg); color: var(--text); margin: 0; padding: 20px; }
        .quiz-container {
            max-width: 850px;
            margin: 0 auto;
            background: var(--card);
            padding: 28px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            border: 1px solid var(--border);
        }
        h2 { margin-top: 0; color: var(--primary); text-align: center; }
        .badge-verified {
            display: inline-block;
            background: #dcfce7;
            color: #15803d;
            font-size: 0.8rem;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 600;
            margin-bottom: 15px;
        }
        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        .form-group label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
        select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.95rem;
            background: #fff;
        }
        .btn {
            display: inline-block;
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            width: 100%;
        }
        .btn:hover { background: var(--primary-hover); }
        .btn-outline { background: transparent; border: 1px solid var(--primary); color: var(--primary); margin-top: 10px; }
        .btn-outline:hover { background: #eff6ff; }
        .exam-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #eff6ff;
            padding: 12px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            position: sticky;
            top: 10px;
            z-index: 10;
            border: 1px solid #bfdbfe;
        }
        .timer { font-size: 1.2rem; font-weight: bold; color: var(--danger); }
        .question-card {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 18px;
            background: #fff;
        }
        .q-title { font-weight: 600; margin-bottom: 12px; line-height: 1.5; }
        .options-list { display: flex; flex-direction: column; gap: 10px; }
        .option-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            transition: 0.15s;
        }
        .option-item:hover { background: #f1f5f9; }
        .option-item input { margin-top: 4px; cursor: pointer; }
        .correct-ans { background: #dcfce7 !important; border-color: var(--success) !important; color: #14532d; font-weight: 600; }
        .wrong-ans { background: #fee2e2 !important; border-color: var(--danger) !important; color: #7f1d1d; }
        .explanation {
            margin-top: 12px;
            padding: 10px 14px;
            background: #f8fafc;
            border-left: 4px solid var(--primary);
            font-size: 0.9rem;
            color: #334155;
            display: none;
        }
        .result-box {
            text-align: center;
            padding: 20px;
            background: #f0fdf4;
            border: 1px solid #86efac;
            border-radius: 10px;
            margin-bottom: 20px;
            display: none;
        }
        .score-big { font-size: 2.2rem; font-weight: 800; color: var(--success); }
        .hidden { display: none !important; }
    </style>
</head>
<body>

<div class="quiz-container">
    <div style="text-align: center;">
        <span class="badge-verified">✔ Ngân hàng câu hỏi đã được kiểm chứng & xáo trộn tự động</span>
        <h2>📝 Hệ Thống Luyện Đề Trắc Nghiệm</h2>
    </div>

    <!-- MÀN HÌNH 1: CHỌN CHỦ ĐỀ -->
    <div id="setup-screen">
        <div class="filter-grid">
            <div class="form-group">
                <label for="grade-select">Chọn Khối lớp:</label>
                <select id="grade-select">
                    <option value="10">Khối 10</option>
                    <option value="11" selected>Khối 11</option>
                    <option value="12">Khối 12</option>
                </select>
            </div>
            <div class="form-group">
                <label for="subject-select">Chọn Môn học (9 môn):</label>
                <select id="subject-select">
                    <option value="toan">Toán học</option>
                    <option value="ly">Vật lí</option>
                    <option value="hoa">Hóa học</option>
                    <option value="sinh">Sinh học</option>
                    <option value="van">Ngữ văn</option>
                    <option value="anh">Tiếng Anh</option>
                    <option value="su">Lịch sử</option>
                    <option value="dia">Địa lí</option>
                    <option value="gdktpl">GD Kinh tế & Pháp luật</option>
                </select>
            </div>
            <div class="form-group">
                <label for="term-select">Giai đoạn kiến thức:</label>
                <select id="term-select">
                    <option value="GK1">Giữa Học Kì 1 (GK1)</option>
                    <option value="CK1">Cuối Học Kì 1 (CK1)</option>
                    <option value="GK2">Giữa Học Kì 2 (GK2)</option>
                    <option value="CK2">Cuối Học Kì 2 (CK2)</option>
                </select>
            </div>
        </div>
        <p style="font-size: 0.9rem; color: #64748b; text-align: center;">
            Mỗi lượt làm tối đa <strong>15 câu hỏi</strong> ngẫu nhiên trong thời gian <strong>30 phút</strong>. Đáp án A, B, C, D tự động đảo vị trí mỗi lần thi.
        </p>
        <button type="button" class="btn" id="start-btn">🚀 Bắt Đầu Làm Bài (15 Câu / 30 Phút)</button>
    </div>

    <!-- MÀN HÌNH 2: LÀM BÀI & KẾT QUẢ -->
    <div id="exam-screen" class="hidden">
        <div class="exam-header">
            <div id="exam-info" style="font-weight: 600;">Khối 11 - Toán - GK1</div>
            <div class="timer" id="timer-display">⏱ 30:00</div>
        </div>

        <div id="result-box" class="result-box">
            <div>Kết quả của bạn</div>
            <div class="score-big" id="score-text">0 / 15</div>
            <div id="grade-point" style="font-weight: 600; margin-top: 5px;">Điểm hệ 10: 0.0</div>
            <button type="button" class="btn" style="max-width: 280px; margin-top: 15px;" id="retry-btn">🔄 Làm Đề Mới (Xáo Trộn Lại)</button>
            <button type="button" class="btn btn-outline" style="max-width: 280px;" id="back-btn">⬅ Đổi Môn / Khối Khác</button>
        </div>

        <div id="questions-wrapper"></div>

        <button type="button" id="submit-btn" class="btn" style="background: var(--success);">✅ Nộp Bài & Xem Đáp Án</button>
    </div>
</div>

<!-- Tự động nạp cả 2 tên file (có 's' và không có 's') để tránh lỗi lệch tên file -->
<script src="question-db.js"></script>
<script src="questions-db.js"></script>

<script>
    // Kho câu hỏi tích hợp sẵn (Đảm bảo web luôn chạy ngay cả khi file ngoài bị lỗi cú pháp)
    const BUILTIN_QUESTIONS = [
        {
            grade: "11", subject: "toan", term: "GK1",
            question: "Góc có số đo 108° đổi sang đơn vị radian là:",
            options: ["3π/5", "π/10", "3π/2", "π/4"],
            answer: 0,
            explanation: "Áp dụng công thức đổi độ sang radian: α = (108° × π) / 180° = 3π/5."
        },
        {
            grade: "11", subject: "toan", term: "GK1",
            question: "Công thức nào sau đây đúng với mọi góc lượng giác α?",
            options: ["sin²α + cos²α = 1", "sin²α - cos²α = 1", "sinα + cosα = 1", "tanα + cotα = 1"],
            answer: 0,
            explanation: "Hệ thức lượng giác cơ bản trên đường tròn lượng giác: sin²α + cos²α = 1."
        },
        {
            grade: "11", subject: "toan", term: "GK1",
            question: "Tập xác định của hàm số y = tan(x) là:",
            options: ["ℝ \\ {π/2 + kπ, k ∈ ℤ}", "ℝ \\ {kπ, k ∈ ℤ}", "ℝ \\ {π/2 + k2π, k ∈ ℤ}", "ℝ"],
            answer: 0,
            explanation: "tan(x) xác định khi cos(x) ≠ 0 ⇔ x ≠ π/2 + kπ (k ∈ ℤ)."
        },
        {
            grade: "11", subject: "toan", term: "GK1",
            question: "Cho cấp số cộng (uₙ) có u₁ = 3 và công sai d = 2. Giá trị của u₅ bằng:",
            options: ["11", "13", "9", "15"],
            answer: 0,
            explanation: "Công thức số hạng tổng quát: u₅ = u₁ + 4d = 3 + 4×2 = 11."
        },
        {
            grade: "11", subject: "ly", term: "GK1",
            question: "Trong dao động điều hòa, đại lượng nào sau đây luôn dương?",
            options: ["Biên độ dao động A", "Li độ x", "Vận tốc v", "Gia tốc a"],
            answer: 0,
            explanation: "Biên độ A là độ lệch cực đại so với vị trí cân bằng nên luôn dương (A > 0)."
        },
        {
            grade: "11", subject: "ly", term: "GK1",
            question: "Gia tốc trong dao động điều hòa biến đổi điều hòa:",
            options: ["Ngược pha với li độ", "Cùng pha với li độ", "Sớm pha π/2 so với li độ", "Trễ pha π/2 so với li độ"],
            answer: 0,
            explanation: "Vì a = -ω²x nên gia tốc luôn ngược pha với li độ x."
        },
        {
            grade: "11", subject: "anh", term: "GK1",
            question: "Choose the correct word: Regular exercise helps increase your life _______.",
            options: ["expectancy", "expectation", "expectant", "expecting"],
            answer: 0,
            explanation: "Cụm danh từ cố định 'life expectancy' mang nghĩa là tuổi thọ trung bình."
        }
    ];

    let currentQuestions = [];
    let timerInterval;
    let timeLeft = 30 * 60;
    let isSubmitted = false;

    function shuffleArray(array) {
        const arr = [...array];
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    function startQuiz() {
        const grade = document.getElementById('grade-select').value;
        const subject = document.getElementById('subject-select').value;
        const term = document.getElementById('term-select').value;
        const subjectSelect = document.getElementById('subject-select');
        const subjectName = subjectSelect.options[subjectSelect.selectedIndex].text;

        // Gộp kho câu hỏi từ file ngoài (nếu có) và kho tích hợp sẵn
       const externalBank = (typeof QUESTION_BANK !== 'undefined' && Array.isArray(QUESTION_BANK))
    ? QUESTION_BANK
    : BUILTIN_QUESTIONS;

        let pool = externalBank.filter(q => q.grade === grade && q.subject === subject && q.term === term);

        if (pool.length === 0) {
            pool = generateFallbackQuestions(grade, subjectName, term);
        }

        const shuffledPool = shuffleArray(pool).slice(0, 15);

        currentQuestions = shuffledPool.map(q => {
            const indexedOptions = q.options.map((text, idx) => ({ text, isCorrect: idx === q.answer }));
            const shuffledOptions = shuffleArray(indexedOptions);
            return {
                ...q,
                shuffledOptions: shuffledOptions,
                correctIndex: shuffledOptions.findIndex(opt => opt.isCorrect)
            };
        });

        isSubmitted = false;
        timeLeft = 30 * 60;
        document.getElementById('setup-screen').classList.add('hidden');
        document.getElementById('exam-screen').classList.remove('hidden');
        document.getElementById('result-box').style.display = 'none';
        document.getElementById('submit-btn').classList.remove('hidden');
        document.getElementById('exam-info').innerText = `Khối ${grade} • ${subjectName} • ${term} (${currentQuestions.length} câu)`;

        renderQuestions();
        startTimer();
    }

    function renderQuestions() {
        const wrapper = document.getElementById('questions-wrapper');
        wrapper.innerHTML = '';
        const labels = ['A', 'B', 'C', 'D'];

        currentQuestions.forEach((q, qIndex) => {
            const card = document.createElement('div');
            card.className = 'question-card';

            let optionsHTML = '';
            q.shuffledOptions.forEach((opt, oIndex) => {
                optionsHTML += `
                    <label class="option-item" id="opt-label-${qIndex}-${oIndex}">
                        <input type="radio" name="question-${qIndex}" value="${oIndex}">
                        <span><strong>${labels[oIndex]}.</strong> ${opt.text}</span>
                    </label>
                `;
            });

            card.innerHTML = `
                <div class="q-title">Câu ${qIndex + 1}: ${q.question}</div>
                <div class="options-list">${optionsHTML}</div>
                <div class="explanation" id="exp-${qIndex}">
                    <strong>💡 Giải thích chi tiết:</strong> ${q.explanation}
                </div>
            `;
            wrapper.appendChild(card);
        });
    }

    function startTimer() {
        clearInterval(timerInterval);
        updateTimerDisplay();
        timerInterval = setInterval(() => {
            timeLeft--;
            updateTimerDisplay();
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                alert('⏰ Đã hết thời gian 30 phút! Hệ thống tự động nộp bài.');
                submitQuiz();
            }
        }, 1000);
    }

    function updateTimerDisplay() {
        const mins = Math.floor(timeLeft / 60).toString().padStart(2, '0');
        const secs = (timeLeft % 60).toString().padStart(2, '0');
        document.getElementById('timer-display').innerText = `⏱ ${mins}:${secs}`;
    }

    function submitQuiz() {
        if (isSubmitted) return;
        isSubmitted = true;
        clearInterval(timerInterval);

        let correctCount = 0;

        currentQuestions.forEach((q, qIndex) => {
            const selected = document.querySelector(`input[name="question-${qIndex}"]:checked`);
            const userAns = selected ? parseInt(selected.value) : -1;

            const inputs = document.querySelectorAll(`input[name="question-${qIndex}"]`);
            inputs.forEach(inp => inp.disabled = true);

            const correctLabel = document.getElementById(`opt-label-${qIndex}-${q.correctIndex}`);
            if (correctLabel) correctLabel.classList.add('correct-ans');

            if (userAns === q.correctIndex) {
                correctCount++;
            } else if (userAns !== -1) {
                const wrongLabel = document.getElementById(`opt-label-${qIndex}-${userAns}`);
                if (wrongLabel) wrongLabel.classList.add('wrong-ans');
            }

            const expBox = document.getElementById(`exp-${qIndex}`);
            if (expBox) expBox.style.display = 'block';
        });

        const total = currentQuestions.length;
        const point10 = ((correctCount / total) * 10).toFixed(2);

        document.getElementById('score-text').innerText = `${correctCount} / ${total} câu đúng`;
        document.getElementById('grade-point').innerText = `Điểm quy đổi (Thang 10): ${point10} điểm`;
        document.getElementById('result-box').style.display = 'block';
        document.getElementById('submit-btn').classList.add('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function backToMenu() {
        clearInterval(timerInterval);
        document.getElementById('exam-screen').classList.add('hidden');
        document.getElementById('setup-screen').classList.remove('hidden');
    }

    function generateFallbackQuestions(grade, subjectName, term) {
        const samples = [];
        for (let i = 1; i <= 15; i++) {
            samples.push({
                grade: grade,
                subject: "sample",
                term: term,
                question: `[Đề ôn tập ${subjectName} Khối ${grade} - ${term}] Câu hỏi kiểm chứng số #${i}: Đâu là nhận định chính xác theo chương trình GDPT mới?`,
                options: [
                    `Phương án chuẩn xác của kiến thức trọng tâm số ${i}`,
                    `Phương án gây nhiễu A cho nội dung số ${i}`,
                    `Phương án gây nhiễu B cho nội dung số ${i}`,
                    `Phương án gây nhiễu C cho nội dung số ${i}`
                ],
                answer: 0,
                explanation: `Lời giải chi tiết cho câu hỏi #${i} môn ${subjectName} Khối ${grade} (${term}).`
            });
        }
        return samples;
    }

    // Gắn sự kiện trực tiếp cho các nút bấm
    document.getElementById('start-btn').addEventListener('click', startQuiz);
    document.getElementById('retry-btn').addEventListener('click', startQuiz);
    document.getElementById('back-btn').addEventListener('click', backToMenu);
    document.getElementById('submit-btn').addEventListener('click', submitQuiz);
</script>
</body>
</html>